{
  "model": "rti.t2i.remote",
  "name": "RTI T2i Remote",
  "vendor": "RTI",
  "proxy": "remote",
  "comment": "Driver-owned decoder; core reads it as data. The radio unicasts each button as ASCII 'K<code>' on genOnOff. Every code emits an action, so all 53 buttons are automation triggers in core, not only those that resolve to a room command.",

  "fingerprint": { "profile": 49297, "endpoint": 1, "in_clusters": [2, 3, 11, 13] },

  "decode": [
    {
      "cluster": "genOnOff",
      "match": { "raw": "^K(\\d+)" },
      "emit": "action",
      "map": {
        "128": "exit",
        "129": "mute_toggle",
        "130": "soft_left_center",
        "131": "up",
        "132": "left",
        "133": "right",
        "134": "down",
        "135": "select",
        "136": "soft_left",
        "137": "soft_right",
        "138": "volume_up",
        "139": "volume_down",
        "140": "channel_up",
        "141": "channel_down",
        "142": "guide",
        "143": "menu",
        "144": "info",
        "145": "power_off",
        "146": "play",
        "147": "pause",
        "148": "stop",
        "149": "record",
        "150": "scan_reverse",
        "151": "scan_forward",
        "152": "skip_back",
        "153": "skip_forward",
        "154": "digit_1",
        "155": "digit_2",
        "156": "digit_3",
        "157": "digit_4",
        "158": "digit_5",
        "159": "digit_6",
        "160": "digit_7",
        "161": "digit_8",
        "162": "digit_9",
        "163": "digit_0",
        "164": "dash_dot",
        "165": "enter",
        "166": "scroll_up",
        "167": "scroll_select",
        "168": "scroll_down",
        "169": "scroll_left",
        "170": "scroll_right",
        "171": "power_on",
        "172": "list",
        "173": "red",
        "174": "green",
        "175": "yellow",
        "176": "blue"
      }
    }
  ]
}
